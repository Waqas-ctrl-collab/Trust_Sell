# Trust Sell Backend Environment Configuration
ENV=development

# MongoDB Connection
# Replace with your MongoDB Atlas URL once available, e.g.:
# MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=trust_sell

# Security Configuration
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Upload Configuration for Verification Documents & Selfies
UPLOAD_DIR=uploads
